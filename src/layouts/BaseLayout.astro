---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import { business } from '../data/site';
import { defaultLocale } from '../i18n/config';
import { withBase } from '../utils/paths';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  canonicalPath?: string;
  includeSchema?: boolean;
}

const { title, description, noindex = false, canonicalPath, includeSchema = true } = Astro.props;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const fullTitle = title.includes('ElMiCo') ? title : `${title} | ElMiCo`;
const logoUrl = new URL('/images/elmico-logo.png', Astro.site);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: business.name,
  legalName: business.legalName,
  url: business.url,
  logo: logoUrl.href,
  email: business.email,
  telephone: business.phoneHref,
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address.street,
    addressLocality: business.address.city,
    postalCode: business.address.postalCode,
    addressCountry: business.address.country,
  },
};
---

<!doctype html>
<html lang={defaultLocale}>
  <head>
    <ClientRouter />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="el" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="icon" type="image/png" href={withBase('/images/elmico-logo.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="el_GR" />
    <meta property="og:site_name" content="ElMiCo" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={logoUrl} />
    <meta property="og:image:alt" content="Λογότυπο ElMiCo" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={logoUrl} />
    <title>{fullTitle}</title>
    {includeSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
