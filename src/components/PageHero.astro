---
interface Props {
  eyebrow: string;
  title: string;
  intro: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<header class="page-hero">
  <div class="container-shell page-hero-grid">
    <div>
      <span class="eyebrow">{eyebrow}</span>
      <h1>{title}</h1>
    </div>
    <p>{intro}</p>
  </div>
</header>

<style>
  .page-hero {
    background: #f0f7fc;
    padding-block: clamp(4rem, 9vw, 7rem);
  }

  .page-hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 8vw, 7rem);
    align-items: end;
  }

  h1 {
    max-width: 15ch;
    margin: 1.15rem 0 0;
    font-size: clamp(2.6rem, 6vw, 4.8rem);
    letter-spacing: -0.045em;
    line-height: 1.03;
  }

  p {
    max-width: 58ch;
    margin: 0;
    color: #36536e;
    font-size: clamp(1.05rem, 2vw, 1.24rem);
  }

  @media (max-width: 760px) {
    .page-hero-grid {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>
