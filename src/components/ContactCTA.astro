---
import { business, ui } from '../data/site';

interface Props {
  title?: string;
}

const { title = 'Ας συζητήσουμε πώς μπορούμε να σας υποστηρίξουμε.' } = Astro.props;
---

<section class="contact-cta" aria-labelledby="contact-cta-title">
  <div class="container-shell contact-cta-inner">
    <div>
      <span class="eyebrow">Επικοινωνία</span>
      <h2 id="contact-cta-title">{title}</h2>
    </div>
    <div class="actions">
      <a class="button-primary" href={`tel:${business.phoneHref}`}>{ui.callNow}</a>
      <a class="button-secondary" href={`mailto:${business.email}`}>{ui.sendEmail}</a>
    </div>
  </div>
</section>

<style>
  .contact-cta {
    border-top: 1px solid #d7e0e8;
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
  }

  .contact-cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
  }

  h2 {
    max-width: 24ch;
    margin: 1rem 0 0;
    font-size: clamp(1.8rem, 4vw, 3rem);
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .actions {
    display: flex;
    flex-shrink: 0;
    gap: 0.75rem;
  }

  @media (max-width: 760px) {
    .contact-cta-inner,
    .actions {
      align-items: flex-start;
      flex-direction: column;
    }

    .actions {
      width: 100%;
    }
  }
</style>
