---
interface Props {
  number: string;
  title: string;
  description: string;
  href: string;
  linkLabel: string;
}

const { number, title, description, href, linkLabel } = Astro.props;
---

<article class="service-card">
  <span class="number" aria-hidden="true">{number}</span>
  <h3>{title}</h3>
  <p>{description}</p>
  <a class="text-link" href={href}>{linkLabel} <span aria-hidden="true">→</span></a>
</article>

<style>
  .service-card {
    position: relative;
    border-top: 1px solid #b8c7d4;
    padding: 2rem 0 0;
  }

  .number {
    color: #8a5a16;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  h3 {
    margin: 1rem 0 0.75rem;
    font-size: clamp(1.45rem, 3vw, 2rem);
    line-height: 1.15;
  }

  p {
    min-height: 6.5rem;
    margin: 0 0 1.4rem;
    color: #36536e;
  }

  @media (max-width: 700px) {
    p {
      min-height: auto;
    }
  }
</style>
