---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactCTA from '../components/ContactCTA.astro';
import ServiceList from '../components/ServiceList.astro';
import { businessServices } from '../data/site';
---

<BaseLayout
  title="Λογιστικές υπηρεσίες για επιχειρήσεις στην Αθήνα"
  description="Λογιστική, φοροτεχνική και συμβουλευτική υποστήριξη επιχειρήσεων: βιβλία, λογιστήριο, μισθοδοσία, εργατικές υποχρεώσεις και οργάνωση."
>
  <PageHero
    eyebrow="Υπηρεσίες"
    title="Λογιστική υποστήριξη για επιχειρήσεις."
    intro="Υποστηρίζουμε επιχειρήσεις στη διευθέτηση λογιστικών, φορολογικών και οικονομικών θεμάτων, με βάση τις εξατομικευμένες ανάγκες τους."
  />

  <section class="section-space" aria-labelledby="business-services-title">
    <div class="container-shell content-grid">
      <div class="intro-copy">
        <span class="eyebrow">Αντικείμενο υπηρεσιών</span>
        <h2 class="section-title" id="business-services-title">Οργάνωση και καθοδήγηση για την καθημερινή λειτουργία.</h2>
        <p>Στόχος μας είναι η έγκαιρη ενημέρωση για την πορεία της επιχείρησης και τις υποχρεώσεις της προς τους δημόσιους οργανισμούς.</p>
      </div>
      <ServiceList items={businessServices} />
    </div>
  </section>

  <ContactCTA title="Μιλήστε μαζί μας για τις ανάγκες της επιχείρησής σας." />
</BaseLayout>

<style>
  .content-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(3rem, 9vw, 8rem);
    align-items: start;
  }

  .intro-copy {
    position: sticky;
    top: 2rem;
  }

  .intro-copy .section-title {
    margin-top: 1.1rem;
  }

  .intro-copy p {
    color: #36536e;
    font-size: 1.08rem;
  }

  @media (max-width: 800px) {
    .content-grid {
      grid-template-columns: 1fr;
    }

    .intro-copy {
      position: static;
    }
  }
</style>
