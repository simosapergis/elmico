---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactCTA from '../components/ContactCTA.astro';
import ServiceList from '../components/ServiceList.astro';
import { individualServices } from '../data/site';
---

<BaseLayout
  title="Φοροτεχνικές υπηρεσίες για ιδιώτες στην Αθήνα"
  description="Φορολογικές δηλώσεις, Ε9, ρυθμίσεις οφειλών, κάτοικοι εξωτερικού και φοροτεχνική υποστήριξη φυσικών προσώπων από την ElMiCo."
>
  <PageHero
    eyebrow="Υπηρεσίες"
    title="Φοροτεχνική υποστήριξη για ιδιώτες."
    intro="Καθοδήγηση και διεκπεραίωση φορολογικών υποθέσεων για φυσικά πρόσωπα, με συνέπεια και σαφή ενημέρωση."
  />

  <section class="section-space" aria-labelledby="individual-services-title">
    <div class="container-shell content-grid">
      <div class="intro-copy">
        <span class="eyebrow">Αντικείμενο υπηρεσιών</span>
        <h2 class="section-title" id="individual-services-title">Υπεύθυνη διαχείριση των φορολογικών σας υποθέσεων.</h2>
        <p>Η συνεχής ενημέρωση για το μεταβαλλόμενο φορολογικό περιβάλλον μάς επιτρέπει να ανταποκρινόμαστε στις ανάγκες των ιδιωτών.</p>
      </div>
      <ServiceList items={individualServices} />
    </div>
  </section>

  <ContactCTA title="Έχετε κάποια φορολογική υπόθεση που χρειάζεται διευκρίνιση;" />
</BaseLayout>

<style>
  .content-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(3rem, 9vw, 8rem);
    align-items: start;
  }

  .intro-copy {
    position: sticky;
    top: 2rem;
  }

  .intro-copy .section-title {
    margin-top: 1.1rem;
  }

  .intro-copy p {
    color: #36536e;
    font-size: 1.08rem;
  }

  @media (max-width: 800px) {
    .content-grid {
      grid-template-columns: 1fr;
    }

    .intro-copy {
      position: static;
    }
  }
</style>
