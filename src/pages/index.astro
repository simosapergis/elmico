---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { business, ui } from '../data/site';
import { withBase } from '../utils/paths';
---

<BaseLayout
  title="Λογιστικές και φοροτεχνικές υπηρεσίες στην Αθήνα | ELMiCo"
  description="Η ELMiCo παρέχει λογιστικές, φοροτεχνικές και συμβουλευτικές υπηρεσίες σε επιχειρήσεις και ιδιώτες."
>
  <section class="hero">
    <div class="container-shell hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Λογιστικό – Φοροτεχνικό γραφείο</span>
        <h1 class="display-title">Εσείς φροντίζετε την επιχείρησή σας. Εμείς τις υποχρεώσεις της.</h1>
        <p class="lead">Ολοκληρωμένη λογιστική και φοροτεχνική υποστήριξη, με συνέπεια στην ενημέρωση, στις υποχρεώσεις και στις ανάγκες κάθε συνεργάτη.</p>
        <div class="hero-actions">
          <a class="button-primary" href={`tel:${business.phoneHref}`}>{ui.callNow}</a>
          <a class="button-secondary" href="#services">Δείτε τις υπηρεσίες</a>
        </div>
      </div>
      <aside class="hero-panel" aria-label="Στοιχεία επικοινωνίας">
        <div class="hero-panel-links">
          <a href={`tel:${business.phoneHref}`}>{business.phoneDisplay}</a>
          <a href={`mailto:${business.email}`}>{business.email}</a>
        </div>
      </aside>
    </div>
  </section>

  <section id="services" class="section-space services" aria-labelledby="services-title">
    <div class="container-shell">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Οι υπηρεσίες μας</span>
          <h2 class="section-title" id="services-title">Υποστήριξη με καθαρή ενημέρωση και ουσιαστική συνέπεια.</h2>
        </div>
        <p class="lead">Αντιμετωπίζουμε κάθε λογιστικό, φορολογικό και οικονομικό θέμα με βάση τις πραγματικές ανάγκες της επιχείρησης ή του ιδιώτη.</p>
      </div>
      <div class="service-grid">
        <ServiceCard
          number="01"
          title="Για επιχειρήσεις"
          description="Τήρηση βιβλίων, οργάνωση λογιστηρίου, μισθοδοσία, εργατικές υποχρεώσεις και συμβουλευτική υποστήριξη."
          href={withBase('/ypiresies-epixeiriseis/')}
          linkLabel={ui.viewBusinessServices}
        />
        <ServiceCard
          number="02"
          title="Για ιδιώτες"
          description="Φορολογικές δηλώσεις, ακίνητη περιουσία, ρυθμίσεις οφειλών και φοροτεχνική καθοδήγηση για φυσικά πρόσωπα."
          href={withBase('/ypiresies-idiotes/')}
          linkLabel={ui.viewIndividualServices}
        />
      </div>
    </div>
  </section>

  <section class="section-space company-preview">
    <div class="container-shell company-grid">
      <img
        class="company-logo"
        src={withBase('/images/elmico-logo.webp')}
        alt=""
        width="125"
        height="115"
        loading="lazy"
      />
      <div>
        <span class="eyebrow">Η εταιρεία</span>
        <h2 class="section-title">Επαγγελματική υποστήριξη με ανθρώπινη επικοινωνία.</h2>
        <p class="lead">Η ELMiCo είναι μια ομάδα λογιστών, φοροτεχνικών και συμβούλων επιχειρήσεων. Προσφέρει ένα ευρύ φάσμα υπηρεσιών, λειτουργώντας με υπευθυνότητα, συνέπεια και εχεμύθεια.</p>
        <a class="text-link" href={withBase('/i-etaireia/')}>{ui.readCompany} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section id="contact" class="contact-strip" aria-labelledby="contact-title">
    <div class="container-shell contact-strip-inner">
      <div>
        <span class="eyebrow">Επικοινωνία</span>
        <h2 id="contact-title">Χρειάζεστε λογιστική ή φοροτεχνική υποστήριξη;</h2>
      </div>
      <div class="contact-actions">
        <a class="button-primary" href={`tel:${business.phoneHref}`}>{business.phoneDisplay}</a>
        <a class="button-secondary" href={`mailto:${business.email}`}>{ui.sendEmail}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    overflow: hidden;
    background: #f0f7fc;
  }

  .hero-grid {
    display: grid;
    min-height: min(760px, calc(100vh - 8rem));
    grid-template-columns: minmax(0, 1fr) minmax(17rem, 0.34fr);
    align-items: stretch;
  }

  .hero-copy {
    align-self: center;
    padding: clamp(4.5rem, 10vw, 8rem) clamp(2rem, 8vw, 7rem) clamp(4.5rem, 10vw, 8rem) 0;
  }

  .hero-actions,
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  #services,
  #contact {
    scroll-margin-top: 1.5rem;
  }

  .hero-panel {
    position: relative;
    display: flex;
    background: #175b92;
    color: white;
    padding: clamp(2rem, 5vw, 4rem);
  }

  .hero-panel-links {
    position: absolute;
    top: 64%;
    right: clamp(2rem, 5vw, 4rem);
    left: clamp(2rem, 5vw, 4rem);
    display: flex;
    flex-direction: column;
  }

  .hero-panel-links a {
    width: fit-content;
    color: white;
    font-weight: 700;
    text-decoration: none;
  }

  .hero-panel-links a + a {
    margin-top: 0.45rem;
  }

  .hero-panel-links a:hover {
    text-decoration: underline;
  }

  .section-heading {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 8vw, 7rem);
    align-items: end;
  }

  .section-heading .section-title {
    margin-top: 1.1rem;
  }

  .section-heading .lead {
    margin: 0;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 6vw, 5rem);
    margin-top: clamp(3rem, 7vw, 5.5rem);
  }

  .company-preview {
    background: #f4f1eb;
  }

  .company-grid {
    display: grid;
    grid-template-columns: 0.68fr 1.32fr;
    gap: clamp(3rem, 8vw, 8rem);
    align-items: start;
  }

  .company-logo {
    width: min(125px, 56vw);
    height: auto;
    margin-top: clamp(1.8rem, 3vw, 2.25rem);
    filter: brightness(0) saturate(100%) invert(14%) sepia(14%) saturate(2394%) hue-rotate(174deg) brightness(94%);
  }

  .company-grid .section-title {
    margin: 1.1rem 0 1.5rem;
  }

  .company-grid .lead {
    margin-bottom: 1.75rem;
  }

  .contact-strip {
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
  }

  .contact-strip-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
  }

  .contact-strip h2 {
    max-width: 24ch;
    margin: 1rem 0 0;
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1.12;
  }

  .contact-actions {
    flex-shrink: 0;
    margin-top: 0;
  }

  @media (max-width: 850px) {
    .hero-grid,
    .section-heading,
    .company-grid {
      grid-template-columns: 1fr;
    }

    .hero-grid {
      min-height: 0;
    }

    .hero-copy {
      padding-right: 0;
    }

    .hero-panel {
      display: none;
    }

    .section-heading {
      align-items: start;
    }

    .company-logo {
      width: min(125px, 56vw);
      margin-top: 0;
    }

    .contact-strip-inner {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 650px) {
    .service-grid {
      grid-template-columns: 1fr;
    }

    .contact-actions {
      width: 100%;
      flex-direction: column;
    }
  }
</style>
